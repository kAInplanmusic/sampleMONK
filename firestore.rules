rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if the request is valid
    match /presets/{presetId} {
      allow read: if true;
      allow create: if request.resource.data.name is string 
                   && request.resource.data.bpm is number;
      allow update, delete: if true; // Simple sandbox environment rules
    }
    match /audioElements/{elementId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    match /motionSequences/{sequenceId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
